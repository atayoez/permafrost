using Gtk 4.0;
using Adw 1;

template $PermafrostFreezePage: Adw.Bin {
  child: Stack stack {
    transition-type: crossfade;

    StackPage {
      name: "idle";

      child: Adw.PreferencesPage {
        Adw.PreferencesGroup {
          Box {
            orientation: vertical;
            spacing: 6;
            margin-bottom: 6;

            Image {
              icon-name: "io.github.atayoez.Permafrost";
              pixel-size: 96;
              margin-bottom: 6;
            }

            Label {
              label: _("Freeze Distractions");
              wrap: true;
              justify: center;

              styles [
                "title-1",
              ]
            }

            Label {
              label: _("Pick how long and what to block. It stays frozen even after a restart.");
              wrap: true;
              justify: center;

              styles [
                "dimmed",
              ]
            }
          }
        }

        Adw.PreferencesGroup {
          Adw.ToggleGroup mode_group {
            active-name: "timer";
            halign: center;

            Adw.Toggle {
              name: "timer";
              label: _("Timer");
            }

            Adw.Toggle {
              name: "pomodoro";
              label: _("Pomodoro");
            }
          }
        }

        Adw.PreferencesGroup timer_group {
          title: _("Duration");

          Adw.ToggleGroup duration_group {
            active-name: "60";

            Adw.Toggle {
              name: "25";
              label: _("25 min");
            }

            Adw.Toggle {
              name: "60";
              label: _("1 h");
            }

            Adw.Toggle {
              name: "120";
              label: _("2 h");
            }

            Adw.Toggle {
              name: "240";
              label: _("4 h");
            }

            Adw.Toggle {
              name: "custom";
              label: _("Custom");
            }
          }
        }

        Adw.PreferencesGroup custom_group {
          visible: false;

          Box {
            halign: center;
            spacing: 6;

            SpinButton hours_spin {
              orientation: vertical;
              numeric: true;
              width-chars: 2;
              tooltip-text: _("Hours");

              adjustment: Adjustment {
                lower: 0;
                upper: 167;
                step-increment: 1;
                page-increment: 4;
                value: 1;
              };

              styles [
                "time-picker",
              ]
            }

            Label {
              label: ":";

              styles [
                "time-picker-separator",
              ]
            }

            SpinButton minutes_spin {
              orientation: vertical;
              numeric: true;
              wrap: true;
              width-chars: 2;
              tooltip-text: _("Minutes");

              adjustment: Adjustment {
                lower: 0;
                upper: 59;
                step-increment: 5;
                page-increment: 15;
                value: 30;
              };

              styles [
                "time-picker",
              ]
            }
          }
        }

        Adw.PreferencesGroup pomodoro_group {
          visible: false;
          title: _("Pomodoro");

          Adw.SpinRow rounds_row {
            title: _("Rounds");

            adjustment: Adjustment {
              lower: 1;
              upper: 12;
              step-increment: 1;
              value: 4;
            };
          }

          Adw.SpinRow focus_row {
            title: _("Focus");
            subtitle: _("Minutes per round");

            adjustment: Adjustment {
              lower: 5;
              upper: 120;
              step-increment: 5;
              value: 25;
            };
          }

          Adw.SpinRow short_break_row {
            title: _("Short Break");
            subtitle: _("Minutes between rounds");

            adjustment: Adjustment {
              lower: 1;
              upper: 30;
              step-increment: 1;
              value: 5;
            };
          }

          Adw.SpinRow long_break_row {
            title: _("Long Break");
            subtitle: _("Minutes after every 4th round; 0 for none");

            adjustment: Adjustment {
              lower: 0;
              upper: 60;
              step-increment: 5;
              value: 15;
            };
          }
        }

        Adw.PreferencesGroup {
          Box {
            orientation: vertical;
            spacing: 8;

            Button freeze_button {
              label: _("Freeze _Now");
              use-underline: true;
              halign: center;

              styles [
                "suggested-action",
                "pill",
              ]
            }

            Label lock_hint {
              wrap: true;
              justify: center;

              styles [
                "dimmed",
                "caption",
              ]
            }
          }
        }

        Adw.PreferencesGroup lists_group {
          title: _("Block");
        }
      };
    }

    StackPage {
      name: "frozen";

      child: Adw.PreferencesPage {
        Adw.PreferencesGroup {
          Box {
            orientation: vertical;
            spacing: 18;

            Overlay {
              halign: center;

              child: $PermafrostCountdownRing ring {};

              [overlay]
              Box {
                orientation: vertical;
                halign: center;
                valign: center;

                Label countdown_label {
                  styles [
                    "countdown",
                  ]
                }

                Label {
                  label: _("remaining");

                  styles [
                    "dimmed",
                  ]
                }
              }
            }

            Box {
              orientation: vertical;
              spacing: 4;

              Label until_label {
                wrap: true;
                justify: center;

                styles [
                  "title-2",
                ]
              }

              Label lock_label {
                wrap: true;
                justify: center;

                styles [
                  "dimmed",
                ]
              }

              Label phase_label {
                visible: false;
                wrap: true;
                justify: center;

                styles [
                  "accent",
                  "heading",
                ]
              }
            }
          }
        }

        Adw.PreferencesGroup active_group {}

        Adw.PreferencesGroup {
          Box {
            halign: center;
            spacing: 12;

            Button add_time_button {
              label: _("_Add 15 Minutes");
              use-underline: true;

              styles [
                "pill",
              ]
            }

            Button stop_button {
              label: _("_Unfreeze");
              use-underline: true;

              styles [
                "destructive-action",
                "pill",
              ]
            }
          }
        }
      };
    }
  };
}
