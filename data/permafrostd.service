[Unit]
Description=Permafrost blocking service
Documentation=https://github.com/atayoez/permafrost

[Service]
Type=dbus
BusName=io.github.atayoez.Permafrost1
ExecStart=/usr/libexec/permafrostd
Restart=always
RestartSec=2
StateDirectory=permafrost
# Writes /etc/hosts and browser policies under /etc, and closes apps in the user cgroups.
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
